<%# locals: (css_classes: "", responsive: false, collapse_after: nil, **html_options) %>
<%# collapse_after is deprecated and ignored; see BreadcrumbsHelper. %>
<% merged_data = merge_component_data(html_options,
    component: :breadcrumbs
  )

  merged_data[:controller] = "breadcrumb" if responsive

  # A caller's aria-label (either spelling) replaces the default one.
  aria = (html_options.delete(:aria) || {}).symbolize_keys
  aria[:label] = html_options.delete(:"aria-label") || aria[:label] || "Breadcrumb" %>

<%= content_tag :nav, class: css_classes.presence, data: merged_data, aria: aria, **html_options do %>
  <%= yield %>
<% end %>
