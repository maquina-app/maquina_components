<%# locals: (show_icon: true, variant: nil, size: nil, css_classes: "", **html_options) %>
<%
  # Without variant: it is the drawer's icon button (drawer.css). With one it
  # renders as a regular data-component="button" in that variant and size.
  button_data = variant ? {component: :button, variant: variant, size: size} : {}
  merged_data = merge_component_data(html_options,
    **button_data,
    drawer_part: :close,
    action: "click->drawer#close"
  )
%>
<%= content_tag :button, type: :button, class: css_classes.presence, data: merged_data, **html_options do %>
  <% if show_icon %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  <% end %>
  <%= yield %>
<% end %>
