<% content_for :title, "maquina_components — component showcase" %>
<% content_for :header do %>
  <h1 class="text-sm font-medium">Showcase</h1>
<% end %>

<%
  preview_count = @manifest.values.sum(&:size)
  specimens = @manifest["specimen"] || []
  components = @manifest.except("specimen")
  orphans = @manifest.flat_map { |component, examples|
    examples.map { |example| "#{component}/#{example}" }
  }.reject { |path| @documented.include?(path) }
%>

<div class="mx-auto max-w-6xl space-y-8 pb-12">
  <header class="space-y-2">
    <h2 class="text-2xl font-bold tracking-tight">Component showcase</h2>
    <p class="max-w-prose text-sm text-muted-foreground">
      Every preview in <code class="rounded bg-muted px-1">app/views/previews</code>,
      generated from <code class="rounded bg-muted px-1">PreviewRegistry.manifest</code>.
      Drop a file into a component directory and it appears here — no registration.
    </p>
  </header>

  <%= render "components/stats/stats_grid", columns: 4, cards: [
    { title: "Components", value: @manifest.size, icon: :grid },
    { title: "Previews", value: preview_count, icon: :list },
    { title: "Embedded in docs", value: @documented.size, icon: :circle_check },
    { title: "Not referenced", value: orphans.size, icon: :circle_alert }
  ] %>

  <%= render "components/alert", variant: :info, icon: :info do %>
    <%= render "components/alert/title", text: "Preview URLs take query parameters" %>
    <%= render "components/alert/description", content: capture { %>
      <ul class="mt-2 space-y-1 text-sm">
        <li><code class="rounded bg-muted px-1">?theme=dark</code> — dark mode (the docs site's own toggle; do not add values to it)</li>
        <li><code class="rounded bg-muted px-1">?color_theme=neutral|green|rose|blue</code> — color theme</li>
        <li><code class="rounded bg-muted px-1">?shape_theme=brutal|soft</code> — shape theme, token values only</li>
      </ul>
    <% } %>
  <% end %>

  <% if specimens.any? %>
    <section class="space-y-3">
      <div class="space-y-1">
        <h3 class="text-lg font-semibold tracking-tight">Specimens</h3>
        <p class="max-w-prose text-sm text-muted-foreground">
          Cross-component pages: every state, every token role. Open one with a
          shape theme to watch the token layer move the whole library at once.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <% specimens.each do |example| %>
          <%= render "components/card" do %>
            <%= render "components/card/header" do %>
              <%= render "components/card/title", text: example.titleize, size: :sm %>
            <% end %>
            <%= render "components/card/content" do %>
              <div class="flex flex-wrap gap-2">
                <%= link_to "Open", preview_path("specimen", example),
                      data: { component: "button", variant: "primary", size: "sm" },
                      target: "_blank" %>
                <%= link_to "Brutal", preview_path("specimen", example, shape_theme: "brutal"),
                      data: { component: "button", variant: "outline", size: "sm" },
                      target: "_blank" %>
                <%= link_to "Soft", preview_path("specimen", example, shape_theme: "soft"),
                      data: { component: "button", variant: "outline", size: "sm" },
                      target: "_blank" %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="space-y-3">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-lg font-semibold tracking-tight">Components</h3>
      <%= link_to "Preview index", previews_path,
            data: { component: "button", variant: "ghost", size: "sm" } %>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% components.each do |component, examples| %>
        <%= render "components/card" do %>
          <%= render "components/card/header" do %>
            <%= render "components/card/title", text: component.titleize, size: :sm %>
            <%= render "components/card/description",
                  text: "#{examples.size} #{"preview".pluralize(examples.size)}" %>
          <% end %>
          <%= render "components/card/content" do %>
            <div class="flex flex-wrap gap-2">
              <% examples.each do |example| %>
                <% embedded = @documented.include?("#{component}/#{example}") %>
                <%= link_to example.titleize,
                      preview_path(component, example),
                      data: { component: "button", variant: embedded ? "secondary" : "outline", size: "sm" },
                      title: embedded ? "Embedded in docs/#{component}.md" : "Not referenced by any doc",
                      target: "_blank" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="space-y-3">
    <h3 class="text-lg font-semibold tracking-tight">Not referenced by any doc</h3>
    <p class="max-w-prose text-sm text-muted-foreground">
      These render, but no <code class="rounded bg-muted px-1">&lt;!-- preview: --&gt;</code>
      tag points at them. Harmless — the reverse, a tag with no file, silently 404s
      a published documentation page.
    </p>
    <% if orphans.any? %>
      <div class="flex flex-wrap gap-2">
        <% orphans.each do |path| %>
          <% component, example = path.split("/") %>
          <%= link_to path, preview_path(component, example),
                data: { component: "badge", variant: "outline" },
                target: "_blank" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted-foreground">None — every preview is embedded somewhere.</p>
    <% end %>
  </section>
</div>
