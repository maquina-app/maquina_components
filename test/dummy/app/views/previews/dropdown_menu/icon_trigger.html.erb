<%# align: :end anchors the menu's right edge to the trigger's, so the menu
    opens leftward. That only makes sense with the trigger at the right of its
    row — a table row's actions, a card header. Left-aligned, a right-aligned
    menu runs off the edge, because the engine positions with plain CSS and has
    no collision detection. %>
<%= preview_container width: :md do %>
  <div class="flex items-center justify-between gap-3 rounded-lg border p-3"
       style="border-color: var(--border)">
    <span class="text-sm font-medium">Project settings</span>

  <%= render "components/dropdown_menu" do %>
    <%= render "components/dropdown_menu/trigger", as_child: true do %>
      <button type="button"
              data-component="button"
              data-variant="ghost"
              data-size="icon"
              data-dropdown-menu-target="trigger"
              data-action="dropdown-menu#toggle"
              aria-haspopup="menu"
              aria-expanded="false">
        <%= icon_for :more_horizontal, class: "size-4" %>
      </button>
    <% end %>

    <%= render "components/dropdown_menu/content", align: :end do %>
      <%= render "components/dropdown_menu/item", href: "#" do %>Edit<% end %>
      <%= render "components/dropdown_menu/item", href: "#" do %>Duplicate<% end %>
      <%= render "components/dropdown_menu/separator" %>
      <%= render "components/dropdown_menu/item", href: "#", variant: :destructive do %>Delete<% end %>
    <% end %>
  <% end %>
  </div>
<% end %>
