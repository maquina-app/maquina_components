# Runs the dummy app against the *packaged* gem instead of the source tree, so
# a file missing from the gemspec's file list fails here rather than on someone
# else's `gem install`.
#
#   bin/vendor-gem
#   BUNDLE_GEMFILE=Gemfile.vendored bundle install
#   BUNDLE_GEMFILE=Gemfile.vendored bin/test
#
# test/dummy/config/boot.rb keys off this file's name to stop the source tree's
# lib/ from shadowing the packaged one on $LOAD_PATH.

source "https://rubygems.org"

vendored = Dir[File.expand_path("test/dummy/vendor/gems/maquina-components-*", __dir__)].max
raise "No vendored gem found — run bin/vendor-gem first." unless vendored

gem "maquina-components", path: vendored

eval_gemfile "Gemfile.common"
