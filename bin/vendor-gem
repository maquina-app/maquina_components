#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the gem and unpacks it into the dummy app's vendor directory, so the
# dummy can run against the *packaged* gem instead of the source tree.
#
# The point is to catch what the source tree hides: a file that exists on disk
# but never reaches the .gem, because gemspec `files` is a Dir glob and a new
# directory is easy to miss. A missing stylesheet or partial looks fine in
# development and breaks on the first `gem install`.
#
#   bin/vendor-gem                      # build + unpack
#   BUNDLE_GEMFILE=Gemfile.vendored bin/rails -T   # run anything against it
#
# See the "Verifying the packaged gem" section of README.md.

require "fileutils"
require "shellwords"

ROOT = File.expand_path("..", __dir__)
VENDOR_DIR = File.join(ROOT, "test/dummy/vendor/gems")

require_relative "../lib/maquina_components/version"
version = MaquinaComponents::VERSION
gem_file = File.join(ROOT, "maquina-components-#{version}.gem")

Dir.chdir(ROOT) do
  puts "Building maquina-components #{version}…"
  abort "gem build failed" unless system("gem", "build", "maquina-components.gemspec", "--quiet")
  abort "expected #{gem_file} to exist after build" unless File.exist?(gem_file)

  # Start clean: a stale unpack is worse than none, because it still boots.
  FileUtils.rm_rf(Dir[File.join(VENDOR_DIR, "maquina-components-*")])
  FileUtils.mkdir_p(VENDOR_DIR)

  puts "Unpacking into #{VENDOR_DIR.sub("#{ROOT}/", "")}…"
  abort "gem unpack failed" unless system(
    "gem", "unpack", gem_file, "--target", VENDOR_DIR
  )

  unpacked = Dir[File.join(VENDOR_DIR, "maquina-components-*")].max
  abort "nothing unpacked" unless unpacked

  # `gem unpack` extracts files but not the spec, and Bundler's path: source
  # needs a gemspec in the directory. Write the one the package actually
  # carries — its explicit file list is what we are here to check.
  spec = `gem specification #{Shellwords.escape(gem_file)} --ruby`
  abort "could not read the packaged gemspec" unless $?.success? && !spec.empty?
  File.write(File.join(unpacked, "maquina-components.gemspec"), spec)

  FileUtils.rm_f(gem_file)
end

unpacked = Dir[File.join(VENDOR_DIR, "maquina-components-*")].max
abort "nothing unpacked" unless unpacked

count = Dir.glob("#{unpacked}/**/*").count { |path| File.file?(path) }
puts "Vendored #{count} files at #{unpacked.sub("#{ROOT}/", "")}"
puts
puts "Run against it with:"
puts "  BUNDLE_GEMFILE=Gemfile.vendored bundle install"
puts "  BUNDLE_GEMFILE=Gemfile.vendored bin/test"
puts "  cd test/dummy && BUNDLE_GEMFILE=../../Gemfile.vendored bin/rails server"
